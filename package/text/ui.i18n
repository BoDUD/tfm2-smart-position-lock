{
  "ko": {
    "smart_position_lock": {
      "title": "스마트 포지션 잠금 · Smart Position Lock",
      "hint": "포지션을 눌러 챔피언이 맡을 수 있는 위치를 설정 (즉시 적용, settings.ini에 저장). F7 / Esc로 닫기",
      "sw_enabled": "전체 스위치",
      "sw_ai": "AI 픽·라인 잠금",
      "sw_player": "내 픽 잠금",
      "sw_history": "세이브 경기 참고",
      "legend": "초록 = 이 위치 가능 · 수동 = 직접 지정 (↺ 되돌리기) · 내장 = LoL 공식 주 포지션 · 자동 = 밴/픽 카드의 주 포지션 + 이 세이브에서 실제로 맡은 위치",
      "src_manual": "수동",
      "src_builtin": "내장",
      "src_auto": "자동",
      "foot": "챔피언은 밴/픽 화면에 한 번 나온 뒤 여기에 표시됩니다."
    }
  },
  "en": {
    "smart_position_lock": {
      "title": "Smart Position Lock",
      "hint": "Click a position to set where a champion can play - applied at once and saved to settings.ini. F7 / Esc to close",
      "sw_enabled": "Master switch",
      "sw_ai": "Lock AI picks & lanes",
      "sw_player": "Lock my own picks",
      "sw_history": "Use this save's games",
      "legend": "Green = can play there · Manual = set by you (↺ undoes) · Preset = League of Legends official positions · Auto = the ban/pick card's positions + positions played in this save",
      "src_manual": "Manual",
      "src_builtin": "Preset",
      "src_auto": "Auto",
      "foot": "A champion is listed here once it has appeared on the ban/pick screen."
    }
  },
  "ja": {
    "smart_position_lock": {
      "title": "スマートポジションロック · Smart Position Lock",
      "hint": "ポジションをクリックしてチャンピオンの担当位置を設定（即時反映、settings.ini に保存）。F7 / Esc で閉じる",
      "sw_enabled": "全体スイッチ",
      "sw_ai": "AIのピックとレーンを制限",
      "sw_player": "自分のピックを制限",
      "sw_history": "セーブの試合を参照",
      "legend": "緑 = その位置を担当できる · 手動 = あなたが指定（↺ で戻す） · 内蔵 = LoL公式メインポジション · 自動 = ピックカードのメインポジション + このセーブで担当した位置",
      "src_manual": "手動",
      "src_builtin": "内蔵",
      "src_auto": "自動",
      "foot": "チャンピオンはバン/ピック画面に一度登場すると、ここに表示されます。"
    }
  },
